# Public origin for the shared Cloudflare R2 asset bucket.
# Divergent.World assets live under the `divergent-world/` prefix, e.g.
#   https://assets.divergent.world/divergent-world/opengraph.png
# Optional: the app falls back to https://assets.divergent.world when unset.
# Public URLs only — never put R2 / S3 API credentials in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_ASSET_ORIGIN=https://assets.divergent.world
